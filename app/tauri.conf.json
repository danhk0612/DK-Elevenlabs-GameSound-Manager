{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DK GameSound Manager",
  "version": "0.1.0",
  "identifier": "local.dk.gamesound",
  "build": { "frontendDist": "dist" },
  "app": {
    "windows": [{ "title": "DK GameSound Manager", "width": 660, "height": 480 }],
    "security": { "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'" }
  },
  "bundle": { "active": false, "icon": ["icons/icon.ico"] }
}
